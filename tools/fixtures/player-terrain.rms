/* Authored player-land and terrain-clump diagnostic; no starting units yet. */
<LAND_GENERATION>
base_terrain 0
create_player_lands {
  terrain_type 3
  base_size 3
  number_of_tiles 60
  clumping_factor 8
  border_fuzziness 20
  other_zone_avoidance_distance 2
}
<TERRAIN_GENERATION>
create_terrain 3 {
  base_terrain 0
  land_percent 12
  number_of_clumps 20
  spacing_to_other_terrain_types 1
  set_scale_by_groups
  set_avoid_player_start_areas
}
create_terrain 0 {
  base_terrain 3
  number_of_tiles 100
  number_of_clumps 2
  set_scale_by_size
}
<OBJECTS_GENERATION>
create_object 348 {
  number_of_objects 80
}
